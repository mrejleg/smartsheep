@using Microsoft.AspNetCore.Html
@using Web.Domain.Models.MasterDatas
@model Project.Base.Models.RestApis.RestApiResult<SourceVideo>
@{
    // Ikon Feather (https://feathericons.com) untuk kartu panel live
    var iconPaths = new Dictionary<string, string>
    {
        ["users"] = "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path>",
        ["user"] = "<path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle>",
        ["repeat"] = "<polyline points=\"17 1 21 5 17 9\"></polyline><path d=\"M3 11V9a4 4 0 0 1 4-4h14\"></path><polyline points=\"7 23 3 19 7 15\"></polyline><path d=\"M21 13v2a4 4 0 0 1-4 4H3\"></path>",
        ["check-circle"] = "<path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><polyline points=\"22 4 12 14.01 9 11.01\"></polyline>",
        ["clock"] = "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline>",
        ["x-circle"] = "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line>",
        ["pause-circle"] = "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"10\" y1=\"15\" x2=\"10\" y2=\"9\"></line><line x1=\"14\" y1=\"15\" x2=\"14\" y2=\"9\"></line>",
        ["calendar"] = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>",
        ["heart"] = "<path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path>"
    };

    IHtmlContent Icon(string name, int size = 18) => Html.Raw(
        $"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{size}\" height=\"{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"feather feather-{name}\">{iconPaths[name]}</svg>");
}

<style>
    /* Satu layar tanpa scroll: video 70% kiri, panel live 30% kanan. Tinggi kedua card sama (mengikuti yang
       lebih tinggi), maksimal setinggi layar; frame video di tengah card dengan rasio aslinya */
    .stream-page { max-height: calc(100vh - 12.5rem); }
    .stream-video { flex: 0 0 70%; max-width: 70%; }
    .stream-panel { flex: 0 0 30%; max-width: 30%; }
    .stream-video, .stream-panel { display: flex; flex-direction: column; min-height: 0; }
    .stream-video > .card, .stream-panel > .card { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .stream-panel > .card { border-radius: .9rem; overflow: hidden; }
    .stream-video .card-body { flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; }
    .stream-frame { width: 100%; min-height: 12rem; }
    .stream-frame img { display: block; width: 100%; height: auto; max-height: calc(100vh - 21rem); object-fit: contain; border-radius: .375rem; background: #4b4b4b; }
    .stream-frame iframe { display: block; width: 100%; aspect-ratio: 16 / 9; max-height: calc(100vh - 21rem); border: 0; border-radius: .375rem; }

    .stream-info-row { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; font-size: .875rem; padding: .4rem 0; border-bottom: 1px dashed #ebe9f1; }
    .stream-info-row > span:first-child { color: #6e6b7b; white-space: nowrap; }
    .stream-info-row > span:last-child { font-weight: 600; color: #2f2b3d; text-align: right; overflow-wrap: anywhere; }

    .stream-body { display: flex; flex-direction: column; gap: 1.1rem; padding: 1rem 1.15rem; overflow-y: auto; flex: 1 1 auto; min-height: 0; }
    .stream-title { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #6e6b7b; margin-bottom: .55rem; display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; }
    /* Jarak tambahan di atas judul VIDEO dan DATA WORKER (bagian setelah Informasi) */
    .stream-body > div + div > .stream-title { padding-top: .5rem; }
    .stream-title small { font-size: .8rem; text-transform: none; letter-spacing: 0; font-weight: 500; color: #6e6b7b; }
    .stream-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
    .stream-grid .full { grid-column: 1 / -1; }

    .stream-card { display: flex; align-items: center; gap: .7rem; padding: .5rem .75rem; border-radius: .6rem; background: #fff; border: 1px solid #ebe9f1; }
    .stream-card .icon { flex: 0 0 1.9rem; height: 1.9rem; border-radius: .5rem; display: flex; align-items: center; justify-content: center; }
    .stream-card .icon svg { width: 16px; height: 16px; }
    .stream-card .value { font-size: 1.2rem; font-weight: 700; line-height: 1.2; color: #2f2b3d; }
    .stream-card .label { font-size: .8rem; color: #6e6b7b; line-height: 1.25; }
    .tone-teal .icon { background: rgba(26, 144, 134, .12); color: #1a9086; }
    .tone-green .icon { background: rgba(40, 199, 111, .12); color: #28c76f; }
    .tone-blue .icon { background: rgba(0, 207, 232, .12); color: #00a8c6; }
    .tone-purple .icon { background: rgba(115, 103, 240, .12); color: #7367f0; }
    .tone-orange .icon { background: rgba(255, 159, 67, .14); color: #ff9f43; }
    .tone-red .icon { background: rgba(234, 84, 85, .12); color: #ea5455; }

    .stream-card.suckling { background: linear-gradient(135deg, rgba(234, 84, 85, .06), rgba(234, 84, 85, .02)); border-color: rgba(234, 84, 85, .25); }
    .stream-card.suckling.active { background: linear-gradient(135deg, #ea5455, #f08182); border-color: transparent; }
    .stream-card.suckling.active .value, .stream-card.suckling.active .label { color: #fff; }
    .stream-card.suckling.active .icon { background: rgba(255, 255, 255, .2); color: #fff; }
    .stream-badges .badge { margin: .35rem .3rem 0 0; }
    /* Data Worker mengisi sisa tinggi panel (tidak ada area kosong di atas footer): kartu memanjang sampai
       batas, sisanya dibagi rata sebagai jarak antar kartu */
    .stream-body > div:last-child { flex: 1 1 auto; display: flex; flex-direction: column; }
    .stream-list { display: flex; flex-direction: column; justify-content: space-between; gap: .45rem; flex: 1 1 auto; }
    .stream-list .stream-card { flex: 1 1 auto; max-height: 3.75rem; }
    .stream-list .stream-card .label { flex: 1 1 auto; font-size: .875rem; color: #4b465c; line-height: 1.3; }
    .stream-list .stream-card .value { font-size: 1.1rem; }
    #streamEpisodeRange { white-space: nowrap; }
    /* Footer card video tanpa tombol, setinggi footer panel yang berisi tombol Close */
    .stream-video .card-footer { min-height: 4.45rem; flex: 0 0 auto; }


    /* Layar pendek (mis. 1366x768): kartu dan jarak dirapatkan agar tetap satu layar */
    @@media (max-height: 820px) {
        .stream-body { gap: .45rem; padding: .6rem .9rem; }
        .stream-title { margin-bottom: .45rem; }
        .stream-body > div + div > .stream-title { padding-top: .45rem; }
        .stream-info-row { padding: .1rem 0; font-size: .82rem; }
        .stream-card { padding: .2rem .6rem; }
        .stream-grid .stream-card { padding: .4rem .7rem; }
        .stream-grid .stream-card > div:last-child { display: flex; align-items: baseline; gap: .4rem; }
        .stream-list .stream-card .label { line-height: 1.2; }
        .stream-card .icon { flex-basis: 1.6rem; height: 1.6rem; }
        .stream-card .value { font-size: 1.05rem; }
        .stream-list { gap: .25rem; }
        .stream-list .stream-card .label { font-size: .85rem; }
        .stream-list .stream-card .value { font-size: 1.05rem; }
        .stream-badges .badge { margin-top: .15rem; }
    }
</style>

<div class="content-header row">
    <div class="content-header-left col-12 mb-1">
        <div class="row breadcrumbs-top">
            <div class="col-12">
                <h2 class="content-header-title float-start mb-0">Source Video</h2>
                <div class="breadcrumb-wrapper">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#">Master Data</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Index">Source Video</a>
                        </li>
                        <li class="breadcrumb-item active"> Streaming </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-body">
    @if (Model.Data == null)
    {
        <div class="alert alert-warning p-1">Source video tidak ditemukan.</div>
    }
    else
    {
        <div class="d-flex gap-1 stream-page">
            <div class="stream-video">
                <div class="card mb-0">
                    <div class="card-header border-bottom py-75">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-video me-50 user-timeline-title-icon">
                                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                            </svg>
                            <h4 class="card-title">Stream Source Video</h4>
                        </div>
                    </div>
                    <div class="card-body p-50">
                        <div class="stream-frame">
                            @if (ViewBag.EmbedUrl != null)
                            {
                                <iframe src="@ViewBag.EmbedUrl" title="@Model.Data.Code" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                            }
                            else
                            {
                                <img src="@Url.Action("StreamFrames", new { id = Model.Data.Id, previewId = ViewBag.PreviewId })" alt="@Model.Data.Code" />
                            }
                        </div>
                    </div>
                    <div class="card-footer"></div>
                </div>
            </div>
            <div class="stream-panel">
                <div class="card mb-0">
                    <div class="card-header border-bottom py-75">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-info me-50 user-timeline-title-icon">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <h4 class="card-title">Detail Information</h4>
                        </div>
                    </div>

                    <div class="stream-body">
                        <div>
                            <div class="stream-title">Informasi</div>
                            <div class="stream-info-row"><span>Kode Kandang</span><span>@Model.Data.Barn?.Code</span></div>
                            <div class="stream-info-row"><span>Nama Kandang</span><span>@Model.Data.Barn?.Name</span></div>
                            <div class="stream-info-row"><span>Sumber Video</span><span>@Model.Data.Code</span></div>
                            <div class="stream-info-row"><span>Tipe</span><span id="streamSourceType">@(ViewBag.EmbedUrl != null ? "Live streaming" : "-")</span></div>
                        </div>

                        @if (ViewBag.EmbedUrl != null)
                        {
                            <div class="alert alert-info p-75 mb-0 small">Inferensi YOLO tidak tersedia untuk sumber YouTube.</div>
                        }
                        else
                        {
                            <div>
                                <div class="stream-title">Video <small id="streamFrameAt"></small></div>
                                <div class="stream-grid">
                                    <div class="stream-card tone-green">
                                        <div class="icon">@Icon("users")</div>
                                        <div><div class="value" id="streamEwe">-</div><div class="label">Induk (ekor)</div></div>
                                    </div>
                                    <div class="stream-card tone-blue">
                                        <div class="icon">@Icon("user")</div>
                                        <div><div class="value" id="streamLamb">-</div><div class="label">Anak (ekor)</div></div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="stream-title">Data Worker <small id="streamWorkerUpdated"></small></div>
                                <div class="stream-list">
                                    <div class="stream-card tone-blue">
                                        <div class="icon">@Icon("calendar")</div>
                                        <div class="label">Episode Indikasi Menyusu <span id="streamEpisodeRange"></span></div><div class="value" id="streamEpisode">-</div>
                                    </div>
                                    <div class="stream-card suckling tone-red" id="streamSucklingCard">
                                        <div class="icon">@Icon("heart")</div>
                                        <div class="label">
                                            Indikasi Sedang Menyusu (ekor)
                                            <div class="stream-badges" id="streamSucklingList"></div>
                                        </div>
                                        <div class="value" id="streamSucklingNow">-</div>
                                    </div>
                                    <div class="stream-card tone-purple">
                                        <div class="icon">@Icon("repeat")</div>
                                        <div class="label">Frekuensi Pendekatan (kali)</div><div class="value" id="streamApproach">-</div>
                                    </div>
                                    <div class="stream-card tone-green">
                                        <div class="icon">@Icon("check-circle")</div>
                                        <div class="label">Jumlah Indikasi Aktivitas Menyusu (kali)</div><div class="value" id="streamFrequency">-</div>
                                    </div>
                                    <div class="stream-card tone-teal">
                                        <div class="icon">@Icon("clock")</div>
                                        <div class="label">Durasi Indikasi Aktivitas Menyusu (detik)</div><div class="value" id="streamDuration">-</div>
                                    </div>
                                    <div class="stream-card tone-orange">
                                        <div class="icon">@Icon("x-circle")</div>
                                        <div class="label">Jumlah Pendekatan Gagal (kali)</div><div class="value" id="streamFailed">-</div>
                                    </div>
                                    <div class="stream-card tone-orange">
                                        <div class="icon">@Icon("pause-circle")</div>
                                        <div class="label">Jeda Waktu Terpanjang (detik)</div><div class="value" id="streamGap">-</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-footer">
                        <div class="float-end">
                            <a asp-action="Index" class="btn btn-round btn btn-outline-secondary waves-effect waves-float waves-light">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x me-50">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>                                Close
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Data != null && ViewBag.EmbedUrl == null)
{
    <script>
        $(document).ready(function () {
            var url = '@Url.Action("StreamStatistic", new { previewId = ViewBag.PreviewId })';
            var episodeMinutes = @ViewBag.EpisodeMinutes;

            // Angka format Indonesia: titik ribuan, koma desimal (maks 1 desimal), mis. 1.250,5
            function number(value) {
                return (value || 0).toLocaleString('id-ID', { maximumFractionDigits: 1 });
            }

            function dateTime(value) {
                if (!value) return '-';
                var d = new Date(value), pad = function (n) { return String(n).padStart(2, '0'); };
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
            }

            function clock(minutes) {
                return String(Math.floor(minutes / 60)).padStart(2, '0') + '.' + String(minutes % 60).padStart(2, '0');
            }

            // Episode ke-n sejak 00.00 menurut jam sekarang dengan panjang SystemConfig
            // (mis. 120 menit: 19.33 = episode 10, 18.00-20.00)
            function episode() {
                var d = new Date();
                var index = Math.floor((d.getHours() * 60 + d.getMinutes()) / episodeMinutes);
                var start = index * episodeMinutes, end = Math.min(start + episodeMinutes, 24 * 60);
                $('#streamEpisode').text(number(index + 1));
                $('#streamEpisodeRange').text('(' + clock(start) + '-' + clock(end) + ')');
            }

            function refresh() {
                $.ajax({ url: url, dataType: 'json', cache: false }).done(function (data) {
                    if (!data) return;
                    $('#streamSourceType').text(data.Status === 'Live' ? 'Live streaming' : data.Status);
                    $('#streamFrameAt').html(data.FrameAt ? dateTime(data.FrameAt) + ' <strong>(' + number(data.Fps) + ' fps)</strong>' : '');
                    $('#streamEwe').text(number(data.EweCount));
                    $('#streamLamb').text(number(data.LambCount));
                    $('#streamWorkerUpdated').text(data.WorkerUpdatedAt ? 'terakhir ' + dateTime(data.WorkerUpdatedAt) : '');
                    $('#streamSucklingNow').text(number(data.SucklingNow.length));
                    $('#streamSucklingCard').toggleClass('active', data.SucklingNow.length > 0);
                    $('#streamSucklingList').html(data.SucklingNow.map(function (s) {
                        return '<span class="badge bg-white text-danger">Anak #' + s.LambTrackId + ' - ' + number(s.Seconds) + ' detik</span>';
                    }).join(''));
                    $('#streamApproach').text(number(data.TotalApproach));
                    $('#streamFrequency').text(number(data.TotalFrequency));
                    $('#streamDuration').text(number(data.TotalDurationSeconds));
                    $('#streamFailed').text(number(data.TotalFailedAttempt));
                    $('#streamGap').text(number(data.LongestGapSeconds));
                });
            }

            episode();
            refresh();
            setInterval(function () { episode(); refresh(); }, 1000);
        });
    </script>
}
