@using Web.Domain.Models.MasterDatas
@model Project.Base.Models.RestApis.RestApiResult<Barn>

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-2">
        <div class="row breadcrumbs-top">
            <div class="col-12">
                <h2 class="content-header-title float-start mb-0">Barn</h2>
                <div class="breadcrumb-wrapper">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#">Master Data</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Index">Barn</a>
                        </li>
                        <li class="breadcrumb-item active"> Form Add </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <partial name="_CustomizerButton" />
</div>
<div class="content-body">
    <div class="row">
        <div class="col-12">
            <form class="form form-horizontal" asp-action="Create" onsubmit="onSaveData(this); return false;">
                <div class="card card-icon">
                    <div class="card-header border-bottom">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-monitor me-50 user-timeline-title-icon">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                <line x1="8" y1="21" x2="16" y2="21"></line>
                                <line x1="12" y1="17" x2="12" y2="21"></line>
                            </svg>                            <h4 class="card-title">Form Data - Add Barn</h4>
                        </div>
                    </div>
                    <div class="card-body py-2 my-25">
                        <div class="row">
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Code <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Data.Code" placeholder="Code" required="required" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Data.Name" placeholder="Name" required="required" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Capacity</label>
                                    <input type="number" class="form-control" asp-for="Data.Capacity" placeholder="Capacity" />
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="mb-1">
                                    <label class="form-label">Length (m)</label>
                                    <input type="number" step="any" min="0" class="form-control" asp-for="Data.Length" placeholder="Length" />
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="mb-1">
                                    <label class="form-label">Width (m)</label>
                                    <input type="number" step="any" min="0" class="form-control" asp-for="Data.Width" placeholder="Width" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Type <span class="text-danger">*</span></label>
                                    <select class="form-select" asp-for="Data.Type" required="required">
                                        <option value="Small">Small</option>
                                        <option value="Large">Large</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Farm</label>
                                    <div id="fk_farm"></div>
                                    <input type="hidden" id="t_fk_farm_id" class="form-control" asp-for="Data.FkFarmId" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Livestock</label>
                                    <div id="fk_livestock"></div>
                                    <input type="hidden" id="t_fk_livestock_id" class="form-control" asp-for="Data.FkLivestockId" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Is Active</label>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" asp-for="Data.IsActive" id="isActiveCheckbox">
                                        <label class="form-check-label" for="isActiveCheckbox">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="float-end">
                            <button type="submit" class="btn btn-round btn-success waves-effect waves-float waves-light me-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check me-50">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>                                Save
                            </button>
                            <a asp-action="Index" class="btn btn-round btn btn-outline-secondary waves-effect waves-float waves-light me-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x me-50">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>                                Close
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        var fk_farmColumns = [
            { 'name': 'Id', 'type': 'object' },
            { 'name': 'Name', 'type': 'string' }
        ];

        var fk_farmId = "@Model.Data.FkFarmId";
        loadDxDropdownBoxColumn("fk_farm", "t_fk_farm_id", "/Farm/Farms", fk_farmId, fk_farmColumns, false);

        var fk_livestockColumns = [
            { 'name': 'Id', 'type': 'object' },
            { 'name': 'Name', 'type': 'string' }
        ];

        var fk_livestockId = "@Model.Data.FkLivestockId";
        loadDxDropdownBoxColumn("fk_livestock", "t_fk_livestock_id", "/Livestock/Livestocks", fk_livestockId, fk_livestockColumns, false);
    });
</script>
