@{
    var title = ViewData["EmptyTitle"]?.ToString() ?? "No data available";
    var message = ViewData["EmptyMessage"]?.ToString() ?? "There are no records to display yet.";
}

<div class="ptk-empty-state" role="status" aria-live="polite">
    <span class="ptk-empty-state__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="10" cy="5" rx="6.5" ry="2.5"></ellipse>
            <path d="M3.5 5v5c0 1.4 2.9 2.5 6.5 2.5 1.1 0 2.2-.1 3.1-.3"></path>
            <path d="M3.5 10v5c0 1.4 2.9 2.5 6.5 2.5"></path>
            <circle cx="17" cy="16" r="3.5"></circle>
            <path d="m19.6 18.6 2 2"></path>
        </svg>
    </span>
    <strong class="ptk-empty-state__title">@title</strong>
    <span class="ptk-empty-state__message">@message</span>
</div>
