@using System.Security.Claims
@using Project.Core.Extentions
@using System.Net
@using Web.Domain.Models.Notifications
@inject Web.Domain.Models.AppSetting appSettings
@inject Web.ApplicationCore.Interfaces.Auths.IAuthService authService
@inject Web.ApplicationCore.Interfaces.Auths.IUserService userService
@{
    var userName = User?.Claims?.FirstOrDefault(x => x.Type == "name")?.Value;
    var resultNotifications = new List<SystemNotification>();
    var notifications = await authService.SystemNotificationsAsync();
    var totalUnread = 0;
    if (notifications.StatusCode == (int)HttpStatusCode.OK && notifications.Data != null)
    {
        totalUnread = notifications.Data.Where(x => x.IsRead == false).ToList().Count;
        resultNotifications = notifications.Data;
    }
    var profileDetail = await userService.GetUserProfileAsync() ?? new Web.Domain.Models.Auths.AppUserResponseDto();
    var nameParts = (profileDetail.FullName ?? string.Empty).Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    var userInitials = nameParts.Length == 0
        ? "?"
        : (nameParts.Length == 1
            ? nameParts[0].Substring(0, 1).ToUpperInvariant()
            : (nameParts[0].Substring(0, 1) + nameParts[1].Substring(0, 1)).ToUpperInvariant());
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isDashboardController = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase);
    var bodyMenuClass = "menu-expanded";
    var bodyPageClass = isDashboardController ? "dashboard-layout" : string.Empty;
}

