    <script>
        $(document).ready(function () {
            $('body, #content-profile, #table-scroll-horizontal, #scroll-container').overlayScrollbars({
                scrollbars: {
                    visibility: 'auto',
                    autoHide: 'leave',
                    autoHideDelay: 800,
                    dragScrolling: true,
                    clickScrolling: false,
                    touchSupport: true,
                    snapHandle: true
                }
            });
            function enhanceFlatpickrMonthPicker(instance) {
                var currentMonth = instance.calendarContainer.querySelector('.flatpickr-current-month');
                var nativeSelect = currentMonth && currentMonth.querySelector('.flatpickr-monthDropdown-months');

                if (!currentMonth || !nativeSelect || currentMonth.querySelector('.ptk-month-picker')) return;

                nativeSelect.classList.add('ptk-native-month-select');

                var picker = document.createElement('div');
                picker.className = 'ptk-month-picker';

                var trigger = document.createElement('button');
                trigger.type = 'button';
                trigger.className = 'ptk-month-picker__trigger';
                trigger.setAttribute('aria-haspopup', 'listbox');
                trigger.setAttribute('aria-expanded', 'false');

                var menu = document.createElement('div');
                menu.className = 'ptk-month-picker__menu';
                menu.setAttribute('role', 'listbox');

                instance.l10n.months.longhand.forEach(function (monthName, monthIndex) {
                    var option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'ptk-month-picker__option';
                    option.textContent = monthName;
                    option.dataset.month = monthIndex;
                    option.setAttribute('role', 'option');
                    option.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        instance.changeMonth(monthIndex, false);
                        syncPicker();
                        picker.classList.remove('is-open');
                        trigger.setAttribute('aria-expanded', 'false');
                    });
                    menu.appendChild(option);
                });

                function syncPicker() {
                    var monthName = instance.l10n.months.longhand[instance.currentMonth];
                    trigger.textContent = monthName;
                    menu.querySelectorAll('.ptk-month-picker__option').forEach(function (option) {
                        var isSelected = Number(option.dataset.month) === instance.currentMonth;
                        option.classList.toggle('is-selected', isSelected);
                        option.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                    });
                }

                trigger.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    document.querySelectorAll('.ptk-month-picker.is-open').forEach(function (openPicker) {
                        if (openPicker !== picker) openPicker.classList.remove('is-open');
                    });
                    var isOpen = picker.classList.toggle('is-open');
                    trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });

                picker.appendChild(trigger);
                picker.appendChild(menu);
                currentMonth.insertBefore(picker, nativeSelect);
                instance._ptkSyncMonthPicker = syncPicker;
                syncPicker();
            }

        if (!window._ptkMonthPickerOutsideClick) {
                window._ptkMonthPickerOutsideClick = true;
                document.addEventListener('click', function () {
                    document.querySelectorAll('.ptk-month-picker.is-open').forEach(function (picker) {
                        picker.classList.remove('is-open');
                        picker.querySelector('.ptk-month-picker__trigger').setAttribute('aria-expanded', 'false');
                    });
                });
            }

            function initializeMonthPicker(dateObj, dateStr, instance) {
                enhanceFlatpickrMonthPicker(instance);
            }

            function syncMonthPicker(dateObj, dateStr, instance) {
                if (instance._ptkSyncMonthPicker) {
                    instance._ptkSyncMonthPicker();
                }
            }

            $(".flatpickr").flatpickr({
                dateFormat: "Y-m-d",
                monthSelectorType: "dropdown",
                onReady: initializeMonthPicker,
                onMonthChange: syncMonthPicker,
                onYearChange: syncMonthPicker
            });

            $(".flatpickr-datetime").flatpickr({
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                time_24hr: true,
                allowInput: true,
                monthSelectorType: "dropdown",
                onReady: function (dateObj, dateStr, instance) {
                    initializeMonthPicker(dateObj, dateStr, instance);
                    var $cal = $(instance.calendarContainer);
                    if ($cal.find('.flatpickr-clear').length < 1) {
                        $cal.append('<div class="btn btn-secondary btn-sm mb-2 mt-2 flatpickr-clear">Clear</div>');
                        $cal.find('.flatpickr-clear').on('click', function () {
                            instance.clear();
                            instance.close();
                        });
                    }
                },
                onMonthChange: syncMonthPicker,
                onYearChange: syncMonthPicker
            });

            $(".flatpickr-month-year").flatpickr({
                plugins: [
                    new monthSelectPlugin({
                        shorthand: true, //defaults to false
                        dateFormat: "m-Y", //defaults to "F Y"
                        altFormat: "F Y", //defaults to "F Y"
                    })
                ]
            });

        });

    </script>
    <script type="text/javascript" src="~/js/page-loader-2026.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/notification-menu.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/button-icons-2026.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/sidebar-menu-2026.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/report-filter-2026.js" asp-append-version="true"></script>
</body>
</html>
