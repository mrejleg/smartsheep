@using Web.Domain.Models.Configs
@inject Web.Domain.Models.AppSetting appSettings
@model Project.Base.Models.RestApis.RestApiResult<News>

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-2">
        <div class="row breadcrumbs-top">
            <div class="col-12">
                <h2 class="content-header-title float-start mb-0">News</h2>
                <div class="breadcrumb-wrapper">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#">Configs</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Index">News</a>
                        </li>
                        <li class="breadcrumb-item active"> Form Edit </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <partial name="_CustomizerButton" />
</div>
<div class="content-body">
    <div class="row">
        <div class="col-12">
            <form class="form form-horizontal" asp-action="Edit" enctype="multipart/form-data" onsubmit="onSaveData(this); return false;">
                <div class="card card-icon">
                    <div class="card-header border-bottom">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-monitor me-50 user-timeline-title-icon">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                <line x1="8" y1="21" x2="16" y2="21"></line>
                                <line x1="12" y1="17" x2="12" y2="21"></line>
                            </svg>                            <h4 class="card-title">Form Data - Edit News</h4>
                        </div>
                    </div>
                    <div class="card-body py-2 my-25">
                        <div class="row">
                            <input type="hidden" asp-for="Data.Id" />
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Code <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Data.Code" placeholder="Code" required="required" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Title <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Data.Title" placeholder="Title" required="required" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Short Content <span class="text-danger">*</span></label>
                                    <textarea rows="3" class="form-control" asp-for="Data.ShortContent" placeholder="Short Content" required="required"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Content <span class="text-danger">*</span></label>
                                    <textarea data-quilljs rows="10" class="form-control" asp-for="Data.Content" placeholder="Content" required="required"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Image Thumbnail</label>
                                    <input type="hidden" asp-for="Data.ImageThumbnail" />
                                    @if (!string.IsNullOrWhiteSpace(Model.Data.ImageThumbnail))
                                    {
                                        <img src="@(appSettings.ApiUrl.Replace("/api/", "/").TrimEnd('/') + Model.Data.ImageThumbnail)" alt="Current thumbnail" class="img-thumbnail d-block mb-1" style="max-height: 180px;" />
                                    }
                                    <input type="file" class="form-control" asp-for="Data.ImageFile" accept="image/jpeg,image/png,image/gif,image/webp" />
                                    <small class="text-muted">Leave empty to keep the current image. Maximum 10 MB.</small>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Start Date</label>
                                    <input type="text" class="form-control flatpickr-datetime" asp-for="Data.StartDate" asp-format="{0:yyyy-MM-dd HH:mm}" autocomplete="off" placeholder="Start Date" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">End Date</label>
                                    <input type="text" class="form-control flatpickr-datetime" asp-for="Data.EndDate" asp-format="{0:yyyy-MM-dd HH:mm}" autocomplete="off" placeholder="End Date" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Is Active</label>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" asp-for="Data.IsActive" id="isActiveCheckbox">
                                        <label class="form-check-label" for="isActiveCheckbox">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="float-end">
                            <button type="submit" class="btn btn-round btn-success waves-effect waves-float waves-light me-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check me-50">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>                                Save
                            </button>
                            <a asp-action="Index" class="btn btn-round btn btn-outline-secondary waves-effect waves-float waves-light me-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x me-50">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>                                Close
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        loadQuilljs();
    });
</script>
