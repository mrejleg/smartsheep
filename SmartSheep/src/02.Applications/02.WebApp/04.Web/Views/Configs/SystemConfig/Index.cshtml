            { 'name': 'YoloConfidenceThreshold', 'type': 'number', 'caption': 'YOLO Confidence Threshold' },
            { 'name': 'YoloMinimumSucklingSeconds', 'type': 'number', 'caption': 'YOLO Minimum Suckling (Seconds)' },
            { 'name': 'YoloSyncIdleSeconds', 'type': 'number', 'caption': 'YOLO Sync Idle (Seconds)' },
            { 'name': 'YoloPendingFolder', 'type': 'string', 'caption': 'YOLO Pending Folder' },
            { 'name': 'YoloMaximumProcessFps', 'type': 'number', 'caption': 'YOLO Maximum Process FPS' },
            { 'name': 'YoloInferenceThreads', 'type': 'number', 'caption': 'YOLO Inference Threads' },
            { 'name': 'YoloSourceRefreshSeconds', 'type': 'number', 'caption': 'YOLO Source Refresh (Seconds)' },
