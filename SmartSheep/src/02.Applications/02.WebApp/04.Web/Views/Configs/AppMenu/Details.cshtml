@using Web.Domain.Models.Configs
@model Project.Base.Models.RestApis.RestApiResult<AppMenu>

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-2">
        <div class="row breadcrumbs-top">
            <div class="col-12">
                <h2 class="content-header-title float-start mb-0">App Menu</h2>
                <div class="breadcrumb-wrapper">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#">Configs</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Index">App Menu</a>
                        </li>
                        <li class="breadcrumb-item active"> Form Add </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <partial name="_CustomizerButton" />
</div>
<div class="content-body">
    <div class="row">
        <div class="col-12">
            <form class="form form-horizontal" asp-action="Edit" onsubmit="onSaveData(this); return false;">
                <div class="card card-icon">
                    <div class="card-header border-bottom">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-monitor me-50 user-timeline-title-icon">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                <line x1="8" y1="21" x2="16" y2="21"></line>
                                <line x1="12" y1="17" x2="12" y2="21"></line>
                            </svg>
                                <h4 class="card-title">Form Data - Add App Menu</h4>
                        </div>
                    </div>
                    <div class="card-body py-2 my-25">
                        <div class="row">
                            <input type="hidden" asp-for="Data.Id" />
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Parent</label>
                                    <div id="fk_parent"></div>
                                    <input type="hidden" id="t_fk_parent_id" class="form-control" asp-for="Data.FkParentId" disabled="disabled" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Data.Name" required="required" placeholder="Name" disabled="disabled">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Controller</label>
                                    <input type="text" class="form-control" asp-for="Data.Controller" placeholder="Controller" disabled="disabled">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Icon</label>
                                    <textarea class="form-control" asp-for="Data.Icon" placeholder="Icon" id="icon" disabled="disabled"></textarea>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Data.Icon))
                            {
                                <div class="col-12">
                                    <div class="mb-1">
                                        <label class="form-label" for="first-name-vertical">Preview Current Icon</label>
                                        <p>
                                            <label class="btn btn-secondary btn-sm">
                                                @Html.Raw(Model.Data.Icon)
                                            </label>
                                        </p>
                                    </div>
                                </div>
                            }
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Icon Active</label>
                                    <textarea class="form-control" asp-for="Data.IconActive" placeholder="Icon Active" id="icon-active" disabled="disabled"></textarea>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Data.IconActive))
                            {
                                <div class="col-12">
                                    <div class="mb-1">
                                        <label class="form-label" for="first-name-vertical">Preview Current Icon Active</label>
                                        <p>
                                            <label class="btn btn-secondary btn-sm">
                                                @Html.Raw(Model.Data.IconActive)
                                            </label>
                                        </p>
                                    </div>
                                </div>
                            }
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Sequence Number <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Data.SequenceNumber" required="required" placeholder="Sequence Number" disabled="disabled">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Access Types <span class="text-danger">*</span></label>
                                    <div>
                                        @foreach (var item in Model.Data.AppMenuAccessTypes)
                                        {
                                            if (Model.Data != null)
                                            {
                                                if (!string.IsNullOrEmpty(Model.Data.AccessTypes))
                                                {
                                                    if (Model.Data.AccessTypes.Split(",").Any(x => x.ToLower() == item.Id.ToString().ToLower()))
                                                    {
                                                        <div class="form-check form-check-inline mb-1">
                                                            <input class="form-check-input" type="checkbox" id="@Html.Raw("chkedit_" + item.Id)" name="@Html.Raw("chk_" + item.Id)" checked="checked" disabled="disabled">
                                                            <label class="form-check-label" for="@Html.Raw("chkedit_" + item.Id)">@item.Text</label>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-check form-check-inline mb-1">
                                                            <input class="form-check-input" type="checkbox" id="@Html.Raw("chkedit_" + item.Id)" name="@Html.Raw("chk_" + item.Id)" disabled="disabled">
                                                            <label class="form-check-label" for="@Html.Raw("chkedit_" + item.Id)">@item.Text</label>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="form-check form-check-inline mb-1">
                                                        <input class="form-check-input" type="checkbox" id="@Html.Raw("chkedit_" + item.Id)" name="@Html.Raw("chk_" + item.Id)" disabled="disabled">
                                                        <label class="form-check-label" for="@Html.Raw("chkedit_" + item.Id)">@item.Text</label>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="form-check form-check-inline mb-1">
                                                    <input class="form-check-input" type="checkbox" id="@Html.Raw("chkedit_" + item.Id)" name="@Html.Raw("chk_" + item.Id)" disabled="disabled">
                                                    <label class="form-check-label" for="@Html.Raw("chkedit_" + item.Id)">@item.Text</label>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Is Section</label>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" asp-for="Data.IsSection" id="isSectionCheckbox" disabled="disabled">
                                        <label class="form-check-label" for="isSectionCheckbox">Section</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Is Mobile</label>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" asp-for="Data.IsMobile" id="isMobileCheckbox" disabled="disabled">
                                        <label class="form-check-label" for="isMobileCheckbox">Mobile</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Created By</label>
                                    <input type="text" id="first-name" class="form-control" asp-for="Data.CreatedBy" disabled="disabled" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Date Created</label>
                                    <input type="text" id="first-name" class="form-control" asp-for="Data.DateCreated" asp-format="{0:yyyy-MM-dd HH:mm}" disabled="disabled" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Modified By</label>
                                    <input type="text" id="first-name" class="form-control" asp-for="Data.ModifiedBy" disabled="disabled" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label" for="first-name-vertical">Date Modified</label>
                                    <input type="text" id="first-name" class="form-control" asp-for="Data.DateModified" asp-format="{0:yyyy-MM-dd HH:mm}" disabled="disabled" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-1">
                                    <label class="form-label">Is Active</label>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" asp-for="Data.IsActive" id="isActiveCheckbox" disabled="disabled">
                                        <label class="form-check-label" for="isActiveCheckbox">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="float-end">
                            <button type="submit" class="btn btn-round btn-success waves-effect waves-float waves-light me-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check me-50">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Save
                            </button>
                            <a asp-action="Index" class="btn btn-round btn btn-outline-secondary waves-effect waves-float waves-light me-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x me-50">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                Close
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        var urlMenuParent = "/AppMenu/AppMenuParents";
        var parentColumns = [
            { 'name': 'Id', 'type': 'object' },
            { 'name': 'Name', 'type': 'string' },
        ];

        var fkParentId = "@Model.Data.FkParentId";
        loadDxDropdownBoxColumn("fk_parent", "t_fk_parent_id", urlMenuParent, fkParentId, parentColumns, true);
    });
</script>
