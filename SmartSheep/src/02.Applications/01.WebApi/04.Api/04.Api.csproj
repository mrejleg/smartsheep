<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Api</RootNamespace>
    <UserSecretsId>461b6713-3787-4074-9acf-3141cc5cd9da</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="FirebaseAdmin" Version="3.6.0" />
	<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
	<!--
		Microsoft.AspNetCore.OpenApi 10.0.5 menarik Microsoft.OpenApi 2.0.0 yang kena
		GHSA-v5pm-xwqc-g5wc (High); aman mulai 2.7.5. Di-pin di jalur 2.x (bukan 3.x)
		supaya tetap kompatibel dengan Microsoft.AspNetCore.OpenApi 10.0.5.
	-->
	<PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
		<PrivateAssets>all</PrivateAssets>
	</PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\03.ApplicationCore\03.ApplicationCore.csproj" />
  </ItemGroup>

</Project>
